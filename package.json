{
  "name": "codebuffy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CodeBuddy-to-API gateway — OpenAI / Anthropic / Responses compatible endpoints over Tencent CodeBuddy upstream",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "bun test test/"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "pino": "^9.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "eslint": "^9.15.0",
    "playwright": "1.62.1",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  }
}
