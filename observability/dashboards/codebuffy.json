{
  "id": null,
  "uid": "codebuffy",
  "title": "Codebuffy",
  "description": "Codebuffy gateway — requests, latency, pool state, credentials, upstream errors",
  "tags": ["codebuffy"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "",
  "preload": false,
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "weekStart": "",
  "links": [],
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource for Codebuffy metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "hide": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(codebuffy_requests_total, route)",
        "query": {
          "query": "label_values(codebuffy_requests_total, route)",
          "refId": "PrometheusDatasourceVariable-env-route"
        },
        "regex": "",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "value": "$__all",
          "text": "All"
        },
        "options": [],
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "visible", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(codebuffy_requests_total{route=~\"$route\"}[5m])) by (route,status)",
          "legendFormat": "{{route}} {{status}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(codebuffy_requests_total[5m])) by (route,status)",
          "hide": true,
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Request duration p50 / p95",
      "type": "timeseries",
      "description": "p50 and p95 from codebuffy_request_duration_seconds histogram",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "visible", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum(rate(codebuffy_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(codebuffy_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Pool state",
      "type": "timeseries",
      "description": "Credentials by pool state — stacked",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "custom": { "stacking": { "mode": "normal", "group": "A" }, "fillOpacity": 60, "lineWidth": 1 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "visible", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "codebuffy_pool_state",
          "legendFormat": "{{state}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Credentials total",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "codebuffy_credentials_total",
          "range": true,
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Upstream errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "visible", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(codebuffy_upstream_errors_total[5m])",
          "legendFormat": "{{code}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(codebuffy_upstream_errors_total[5m]))",
          "legendFormat": "total",
          "range": true
        }
      ]
    }
  ]
}
